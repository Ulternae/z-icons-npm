{
  "name": "@zcorvus/z-icons",
  "version": "0.0.3",
  "description": "Icon library (core & neo) as SVG sprites + Web Component <z-icon>",
  "author": "Ulqernesh Karvenae",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/icon.js",
  "types": "dist/types/icon.d.ts",
  "files": [
    "dist"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/icon.js",
      "types": "./dist/types/icon.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./neo": {
      "import": "./dist/neo/index.js",
      "types": "./dist/neo/index.d.ts"
    }
  },
  "scripts": {
    "sprites": "node scripts/build.js",
    "bundle": "tsup",
    "build": "npm run sprites && npm run bundle",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "svgo": "^3.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}