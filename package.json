{
  "name": "@zcorvus/z-icons",
  "version": "0.0.57",
  "description": "Icon library (core & neo) as SVG sprites + Web Component <z-icon> - Requires Vite optimizeDeps exclusion",
  "author": "Ulqernesh Karvenae",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/icon.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/icon.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./neo": {
      "import": "./dist/neo/index.js",
      "types": "./dist/neo/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "scripts": {
    "sprites": "node scripts/build.js",
    "bundle": "tsup",
    "build": "npm run sprites && npm run bundle",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.27",
    "react": "^18.3.1",
    "svgo": "^3.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}