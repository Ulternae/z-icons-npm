{
  "name": "zcorvus-icons-workspace",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:react": "node scripts/build.js --target=react",
    "build:web": "node scripts/build.js --target=web",
    "build:pack": "node scripts/build.js --target=react",
    "build:standalone": "node scripts/build.js --target=standalone-react",
    "licenses:sync": "node scripts/sync-package-licenses.js",
    "sprites": "node scripts/build.js",
    "test": "vitest run",
    "test:generator": "vitest run tests/svg-utils.test.js tests/fs-utils.test.js tests/generated-types.test.js tests/standalone-packages.test.js tests/license-files.test.js",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node scripts/check-syntax.js",
    "check": "pnpm run check:full",
    "check:fast": "pnpm run check:syntax && pnpm run test:generator",
    "check:full": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run verify:generated",
    "verify:generated": "git diff --exit-code -- packages",
    "pack:check": "node scripts/check-packages.js",
    "release:check": "pnpm run check:full && pnpm run pack:check",
    "prepublishOnly": "pnpm run release:check",
    "optimize:icons": "node scripts/optimize-icons.js",
    "viewbox:icons": "node scripts/fix-viewbox-icons.js",
    "duplicates": "node scripts/find-duplicate-icons.js",
    "dedupe": "node scripts/remove-duplicate-icons.js",
    "sync:variants": "node scripts/sync-variant-icons.js",
    "sync:variants:write": "node scripts/sync-variant-icons.js --write"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.27",
    "@zcorvus/bru-react": "workspace:*",
    "@zcorvus/core-react": "workspace:*",
    "@zcorvus/icons-react": "workspace:*",
    "@zcorvus/icons-web": "workspace:*",
    "@zcorvus/lan-react-light": "workspace:*",
    "@zcorvus/lan-react-regular": "workspace:*",
    "@zcorvus/lan-react-solid": "workspace:*",
    "@zcorvus/lan-react-thin": "workspace:*",
    "@zcorvus/mina-react": "workspace:*",
    "@zcorvus/neo-react": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svgo": "^3.0.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.6"
  }
}
