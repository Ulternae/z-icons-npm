{
  "name": "@zcorvus/core-regular-duo-react",
  "version": "0.1.0",
  "description": "Standalone React components for ZCorvus Core icons.",
  "author": "Ulqernesh Karvenae",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./sprite": {
      "types": "./dist/sprite.d.ts",
      "import": "./dist/sprite.js"
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "dist/types/index.d.ts"
      ],
      "sprite": [
        "dist/sprite.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  }
}