{
  "name": "@zcorvus/icons-react",
  "version": "3.0.0-beta.1",
  "description": "React components for ZCorvus icons.",
  "author": "Ulqernesh Karvenae",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ulternae/z-icons-npm.git",
    "directory": "packages/icons-react"
  },
  "homepage": "https://icons.zcorvus.com/",
  "bugs": {
    "url": "https://github.com/Ulternae/z-icons-npm/issues"
  },
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/verify-package-ready.js ."
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": { "types": "./dist/react/core.d.ts", "import": "./dist/react/core.js" },
    "./neo": { "types": "./dist/react/neo.d.ts", "import": "./dist/react/neo.js" },
    "./mina": { "types": "./dist/react/mina.d.ts", "import": "./dist/react/mina.js" },
    "./bru": { "types": "./dist/react/bru.d.ts", "import": "./dist/react/bru.js" },
    "./lan": { "types": "./dist/react/lan.d.ts", "import": "./dist/react/lan.js" },
    "./packs-data/*": { "types": "./dist/packs-data/*.d.ts", "import": "./dist/packs-data/*.js" },
    "./core/*": { "types": "./dist/react/icon.d.ts", "import": "./dist/react/core/*.js" },
    "./neo/*": { "types": "./dist/react/icon.d.ts", "import": "./dist/react/neo/*.js" },
    "./mina/*": { "types": "./dist/react/icon.d.ts", "import": "./dist/react/mina/*.js" },
    "./bru/*": { "types": "./dist/react/icon.d.ts", "import": "./dist/react/bru/*.js" },
    "./lan/*": { "types": "./dist/react/icon.d.ts", "import": "./dist/react/lan/*.js" }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
