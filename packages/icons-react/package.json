{
  "name": "@zcorvus/icons-react",
  "version": "0.2.0",
  "description": "React components for ZCorvus icons.",
  "author": "Ulqernesh Karvenae",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ulternae/z-icons-npm.git",
    "directory": "packages/icons-react"
  },
  "homepage": "https://icons.zcorvus.com/",
  "bugs": {
    "url": "https://github.com/Ulternae/z-icons-npm/issues"
  },
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/verify-package-ready.js ."
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./packs": {
      "types": "./dist/packs/index.d.ts",
      "import": "./dist/packs/index.js"
    },
    "./create": {
      "types": "./dist/create.d.ts",
      "import": "./dist/create.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./packs-data": {
      "types": "./dist/packs-data/index.d.ts",
      "import": "./dist/packs-data/index.js"
    },
    "./sprites": {
      "types": "./dist/sprites/index.d.ts",
      "import": "./dist/sprites/index.js"
    },
    "./sprites/*": {
      "types": "./dist/sprites/*.d.ts",
      "import": "./dist/sprites/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "packs": [
        "dist/packs/index.d.ts"
      ],
      "create": [
        "dist/create.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ],
      "packs-data": [
        "dist/packs-data/index.d.ts"
      ],
      "sprites": [
        "dist/sprites/index.d.ts"
      ],
      "sprites/*": [
        "dist/sprites/*.d.ts"
      ],
      "*": [
        "dist/*.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
