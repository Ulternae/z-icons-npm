{
  "name": "@zcorvus/icons-web",
  "version": "0.2.0",
  "description": "Web Components for ZCorvus icons.",
  "author": "Ulqernesh Karvenae",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ulternae/z-icons-npm.git",
    "directory": "packages/icons-web"
  },
  "homepage": "https://icons.zcorvus.com/",
  "bugs": {
    "url": "https://github.com/Ulternae/z-icons-npm/issues"
  },
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/verify-package-ready.js ."
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "sideEffects": [
    "./dist/register.js",
    "./dist/register-*.js"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./create": {
      "types": "./dist/create.d.ts",
      "import": "./dist/create.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./register-*": {
      "types": "./dist/register-*.d.ts",
      "import": "./dist/register-*.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "import": "./dist/data/*.js"
    },
    "./sprites/*": {
      "types": "./dist/sprites/*.d.ts",
      "import": "./dist/sprites/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "create": [
        "dist/create.d.ts"
      ],
      "register": [
        "dist/register.d.ts"
      ],
      "register-*": [
        "dist/register-*.d.ts"
      ],
      "data/*": [
        "dist/data/*.d.ts"
      ],
      "sprites/*": [
        "dist/sprites/*.d.ts"
      ]
    }
  }
}
