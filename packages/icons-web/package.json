{
  "name": "@zcorvus/icons-web",
  "version": "0.1.3",
  "description": "Web Components for ZCorvus icons.",
  "author": "Ulqernesh Karvenae",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/register.js",
    "./dist/register-*.js"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./create": {
      "types": "./dist/create.d.ts",
      "import": "./dist/create.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./register-*": {
      "types": "./dist/register-*.d.ts",
      "import": "./dist/register-*.js"
    }
  },
  "typesVersions": {
    "*": {
      "create": [
        "dist/create.d.ts"
      ],
      "register": [
        "dist/register.d.ts"
      ],
      "register-*": [
        "dist/register-*.d.ts"
      ]
    }
  },
  "dependencies": {
    "@zcorvus/icons": "workspace:^"
  }
}
