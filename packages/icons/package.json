{
  "name": "@zcorvus/icons",
  "version": "0.1.9",
  "description": "Framework-agnostic SVG icon library for ZCorvus.",
  "author": "Ulqernesh Karvenae",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ulternae/z-icons-npm.git",
    "directory": "packages/icons"
  },
  "homepage": "https://icons.zcorvus.com/",
  "bugs": {
    "url": "https://github.com/Ulternae/z-icons-npm/issues"
  },
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/verify-package-ready.js ."
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./svg": {
      "types": "./dist/svg/index.d.ts",
      "import": "./dist/svg/index.js"
    },
    "./svg/*": {
      "types": "./dist/svg/*.d.ts",
      "import": "./dist/svg/*.js"
    },
    "./names": {
      "types": "./dist/names/index.d.ts",
      "import": "./dist/names/index.js"
    },
    "./sprites": {
      "types": "./dist/sprites/index.d.ts",
      "import": "./dist/sprites/index.js"
    },
    "./sprites/*": "./dist/sprites/*",
    "./getters": {
      "types": "./dist/getters/index.d.ts",
      "import": "./dist/getters/index.js"
    },
    "./getters/*": {
      "types": "./dist/getters/*.d.ts",
      "import": "./dist/getters/*.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "svg": [
        "dist/svg/index.d.ts"
      ],
      "svg/*": [
        "dist/svg/*.d.ts"
      ],
      "names": [
        "dist/names/index.d.ts"
      ],
      "sprites": [
        "dist/sprites/index.d.ts"
      ],
      "sprites/*": [
        "dist/sprites/*"
      ],
      "getters": [
        "dist/getters/index.d.ts"
      ],
      "getters/*": [
        "dist/getters/*.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ]
    }
  }
}
