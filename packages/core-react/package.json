{
  "name": "@zcorvus/core-react",
  "version": "0.1.0",
  "description": "Standalone React components for ZCorvus Core icons.",
  "author": "Ulqernesh Karvenae",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ulternae/z-icons-npm.git",
    "directory": "packages/core-react"
  },
  "homepage": "https://icons.zcorvus.com/",
  "bugs": {
    "url": "https://github.com/Ulternae/z-icons-npm/issues"
  },
  "type": "module",
  "scripts": {
    "prepack": "node ../../scripts/verify-package-ready.js ."
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./sprite": {
      "types": "./dist/sprite.d.ts",
      "import": "./dist/sprite.js"
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "dist/types/index.d.ts"
      ],
      "sprite": [
        "dist/sprite.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
